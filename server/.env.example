# ==================== 服务基础配置 ====================
HOST=0.0.0.0
PORT=8765
# 强烈建议设置一个随机访问密钥，插件端填写一致的 Token，防止他人白嫖你的 VPS
API_TOKEN=change-me-to-a-strong-secret

# 最大并发推理数（2GB 内存 VPS 建议设为 1，4GB+ 建议设为 2~3）
MAX_WORKERS=1

# ==================== 翻译引擎配置 ====================
# 可选值:
#   auto          - 自动选择：配置了 LLM/Gemini Key 时优先用大模型，否则自动走免费 MyMemory 翻译（国内直连）
#   openai        - 使用 OpenAI 兼容文本接口（推荐 DeepSeek / Qwen / OpenAI，整页语境极便宜且自然）
#   gemini        - 使用 Google Gemini 文本接口
#   mymemory_free - 免费 MyMemory 翻译（国内外均可直连，无需 API Key）
#   google_free   - 免费 Google 翻译（海外 VPS 可用）
TRANSLATOR=auto

# OpenAI 兼容文本翻译配置（以 DeepSeek 为例，翻译 1000 页漫画成本约几毛钱）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Google Gemini 文本翻译配置（可选）
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 目标语言与默认漫画翻译风格提示词
TARGET_LANG=zh-CN
CUSTOM_PROMPT=

# ==================== OCR 与无痕擦字参数 ====================
# 擦字算法: telea (默认，平滑快速) | ns (Navier-Stokes，线条背景表现稍稳)
INPAINT_METHOD=telea
# 识别置信度阈值 (0.3 ~ 0.8)
OCR_MIN_SCORE=0.45
# 送入 OCR 的最大宽/高（超出自动缩放或长图切片，保证 CPU 速度）
MAX_OCR_WIDTH=1800

# ==================== 持久化缓存 ====================
ENABLE_CACHE=true
CACHE_DB_PATH=data/cache.db
CACHE_MAX_MB=500
